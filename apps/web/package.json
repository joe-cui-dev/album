{
  "name": "@album/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:test": "vite --mode test --host 0.0.0.0",
    "dev:e2e": "vite --mode e2e --host 0.0.0.0",
    "build:e2e": "vite build --mode e2e",
    "preview:e2e": "vite preview --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:performance": "playwright test --config=playwright.performance.config.ts"
  },
  "dependencies": {
    "@album/shared": "0.1.0",
    "@tanstack/react-virtual": "^3.14.7",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.2.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  }
}
